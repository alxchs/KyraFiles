<UserControl
	x:Class="KyraFiles.App.UserControls.FilePreviews.CodePreview"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:KyraFiles.App.UserControls.FilePreviews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="300"
	d:DesignWidth="400"
	ActualThemeChanged="UserControl_ActualThemeChanged"
	Loaded="UserControl_Loaded"
	mc:Ignorable="d">

	<Border>
		<ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					x:Name="lineNumbers"
					Padding="10,10,0,10"
					FontFamily="Consolas"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					IsTextSelectionEnabled="False"
					LineHeight="18"
					LineStackingStrategy="BlockLineHeight"
					TextAlignment="Right"
					TextWrapping="NoWrap" />

				<RichTextBlock
					Name="codeView"
					Grid.Column="1"
					Padding="0,10,10,10"
					FontFamily="Consolas"
					LineHeight="18"
					LineStackingStrategy="BlockLineHeight"
					TextWrapping="NoWrap" />
			</Grid>
		</ScrollViewer>
	</Border>
</UserControl>
