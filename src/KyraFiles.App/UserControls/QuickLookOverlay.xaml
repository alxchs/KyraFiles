<UserControl
	x:Class="KyraFiles.App.UserControls.QuickLookOverlay"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	HorizontalAlignment="Stretch"
	VerticalAlignment="Stretch"
	d:DesignHeight="600"
	d:DesignWidth="800"
	PreviewKeyDown="Overlay_PreviewKeyDown"
	mc:Ignorable="d">

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<!--  Translucent Backdrop  -->
		<Border
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Background="#66000000"
			PointerPressed="Backdrop_PointerPressed" />

		<!--  Preview Card  -->
		<Grid
			x:Name="PreviewCard"
			Width="740"
			MaxWidth="1100"
			Height="540"
			MaxHeight="820"
			Margin="24"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="12">
			<Grid.Shadow>
				<ThemeShadow />
			</Grid.Shadow>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  Header  -->
			<Grid
				Grid.Row="0"
				Padding="16,12"
				BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
				BorderThickness="0,0,0,1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel
					Grid.Column="0"
					Orientation="Horizontal"
					Spacing="12"
					VerticalAlignment="Center">
					<Image
						x:Name="HeaderIcon"
						Width="28"
						Height="28"
						VerticalAlignment="Center" />
					<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
						<TextBlock
							x:Name="HeaderTitle"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							FontSize="15"
							MaxLines="1"
							TextTrimming="CharacterEllipsis" />
						<TextBlock
							x:Name="HeaderDetails"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</StackPanel>

				<!--  Close Button  -->
				<Button
					Grid.Column="1"
					Width="32"
					Height="32"
					Padding="0"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Click="CloseButton_Click"
					Style="{StaticResource SubtleButtonStyle}"
					ToolTipService.ToolTip="{helpers:ResourceString Name=Close}">
					<FontIcon FontSize="12" Glyph="&#xE711;" />
				</Button>
			</Grid>

			<!--  Preview Content Host  -->
			<Grid x:Name="ContentArea" Grid.Row="1" Padding="12">
				<Border x:Name="ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

				<ProgressRing
					x:Name="LoadingRing"
					Width="40"
					Height="40"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsActive="False"
					Visibility="Collapsed" />
			</Grid>

			<!--  Footer  -->
			<Grid
				Grid.Row="2"
				Padding="16,8"
				Background="{ThemeResource SubtleFillColorSecondaryBrush}"
				BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
				BorderThickness="0,1,0,0"
				CornerRadius="0,0,12,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="Pressione Espaço ou Esc para fechar" />

				<TextBlock
					Grid.Column="1"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="↑ ↓ para navegar" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
