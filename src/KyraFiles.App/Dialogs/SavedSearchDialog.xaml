<ContentDialog
	x:Class="KyraFiles.App.Dialogs.SavedSearchDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
	CloseButtonText="Cancelar"
	DefaultButton="Primary"
	PrimaryButtonText="Salvar"
	Style="{StaticResource DefaultContentDialogStyle}">

	<StackPanel Width="440" Spacing="10">
		<InfoBar
			IsClosable="False"
			IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
			Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
			Severity="Warning" />

		<TextBox
			Header="Nome na barra lateral"
			PlaceholderText="Ex.: PDFs desta semana"
			Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<TextBox
			Header="Texto ou padrao da busca"
			PlaceholderText="Ex.: *.pdf ou relatorio"
			Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<TextBox
			Header="Pasta de escopo (vazio = Todos os discos / Home)"
			PlaceholderText="Ex.: C:\desenv"
			Text="{x:Bind ViewModel.ScopePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<TextBox
			Header="Extensoes (opcional, separadas por virgula)"
			PlaceholderText="Ex.: .pdf, .docx"
			Text="{x:Bind ViewModel.ExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<Grid ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="120" />
			</Grid.ColumnDefinitions>

			<ComboBox
				Grid.Column="0"
				Header="Filtro de data relativa"
				HorizontalAlignment="Stretch"
				SelectedIndex="{x:Bind ViewModel.RelativeDateIndex, Mode=TwoWay}">
				<ComboBoxItem Content="Sem filtro de data" />
				<ComboBoxItem Content="Hoje" />
				<ComboBoxItem Content="Ontem" />
				<ComboBoxItem Content="Ultimos N dias" />
				<ComboBoxItem Content="Esta semana" />
				<ComboBoxItem Content="Este mes" />
			</ComboBox>

			<NumberBox
				Grid.Column="1"
				Header="Dias (N)"
				Minimum="1"
				Maximum="3650"
				SpinButtonPlacementMode="Compact"
				Value="{x:Bind ViewModel.RelativeDaysCount, Mode=TwoWay}" />
		</Grid>
	</StackPanel>
</ContentDialog>
