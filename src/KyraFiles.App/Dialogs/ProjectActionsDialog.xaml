<ContentDialog
	x:Class="KyraFiles.App.Dialogs.ProjectActionsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:pa="using:KyraFiles.Shared.ProjectActions"
	Title="Comandos de projeto (F045)"
	CloseButtonText="Fechar"
	DefaultButton="Close"
	Style="{StaticResource DefaultContentDialogStyle}">

	<StackPanel Width="560" Spacing="10">
		<InfoBar
			IsClosable="True"
			IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=TwoWay}"
			Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
			Severity="Informational" />

		<Grid ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBox
				Grid.Column="0"
				Header="Nome"
				PlaceholderText="Ex.: Abrir no VS Code"
				Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<TextBox
				Grid.Column="1"
				Header="Executavel"
				PlaceholderText="Ex.: code"
				Text="{x:Bind ViewModel.NewExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<TextBox
				Grid.Column="2"
				Header="Argumentos"
				PlaceholderText="{}{caminho}"
				Text="{x:Bind ViewModel.NewArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<StackPanel Orientation="Horizontal" Spacing="12">
			<CheckBox
				Content="Executar via PowerShell"
				IsChecked="{x:Bind ViewModel.NewUsePowerShell, Mode=TwoWay}" />
			<Button Click="AddCommandButton_Click" Content="Adicionar comando" />
		</StackPanel>

		<ListView
			MaxHeight="150"
			ItemsSource="{x:Bind ViewModel.Commands, Mode=OneWay}"
			SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="pa:CustomProjectCommand">
					<Grid Padding="2,4" ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0">
							<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
							<TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Executable}" />
						</StackPanel>
						<Button
							Grid.Column="1"
							Click="RemoveCommandButton_Click"
							Content="Remover"
							Tag="{x:Bind Id}" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<TextBox
			Height="110"
			AcceptsReturn="True"
			Header="Importar / Exportar JSON (project-actions.json)"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			Text="{x:Bind ViewModel.JsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			TextWrapping="Wrap" />

		<Button
			HorizontalAlignment="Right"
			Click="ImportJsonButton_Click"
			Content="Aplicar JSON" />
	</StackPanel>
</ContentDialog>
