        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\src\Files.App\Helpers\UI\DialogAccessKeys.cs" Link="DialogAccessKeys.cs" />
        <Compile Include="..\..\src\Files.App\Services\Search\EverythingResultLine.cs" Link="EverythingResultLine.cs" />
        <Compile Include="..\..\src\Files.App\Helpers\DocumentationHelper.cs" Link="DocumentationHelper.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Files.App.Search.Index\Files.App.Search.Index.csproj" />
        <ProjectReference Include="..\..\src\Files.App.IndexService\Files.App.IndexService.csproj" />
        <ProjectReference Include="..\..\src\Files.Shared\Files.Shared.csproj" />
    </ItemGroup>

</Project>

