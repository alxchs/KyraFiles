<ContentDialog
	x:Class="KyraFiles.App.Dialogs.BulkRenameDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=BulkRename}"
	Width="860"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
	PrimaryButtonCommand="{x:Bind ViewModel.CommitRenameCommand, Mode=OneWay}"
	PrimaryButtonText="{helpers:ResourceString Name=Rename}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<ResourceDictionary>
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</ContentDialog.Resources>

	<Grid Height="480" ColumnSpacing="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="380" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  Painel Esquerdo: Regras / Edição como Texto  -->
		<TabView
			Grid.Column="0"
			SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
			TabWidthMode="SizeToContent"
			IsAddTabButtonVisible="False">
			<TabView.TabItems>
				<!--  Aba 1: Regras  -->
				<TabViewItem Header="Regras" IsClosable="False">
					<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
						<StackPanel Spacing="12">

							<!--  Substituir  -->
							<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
								<Expander.Header>
									<TextBlock FontWeight="SemiBold" Text="Localizar e Substituir" />
								</Expander.Header>
								<StackPanel Spacing="8">
									<TextBox
										PlaceholderText="Localizar texto ou padrão"
										Text="{x:Bind ViewModel.FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									<TextBox
										PlaceholderText="Substituir por"
										Text="{x:Bind ViewModel.ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									<CheckBox Content="Usar expressões regulares (Regex)" IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}" />
									<CheckBox Content="Diferenciar maiúsculas/minúsculas" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
									<CheckBox Content="Aplicar também na extensão" IsChecked="{x:Bind ViewModel.ApplyToExtension, Mode=TwoWay}" />
								</StackPanel>
							</Expander>

							<!--  Numeração  -->
							<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
								<Expander.Header>
									<Grid ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock FontWeight="SemiBold" Text="Numeração Sequencial" VerticalAlignment="Center" />
										<ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableNumbering, Mode=TwoWay}" OnContent="" OffContent="" />
									</Grid>
								</Expander.Header>
								<StackPanel Spacing="8">
									<ComboBox
										HorizontalAlignment="Stretch"
										Header="Posição"
										IsEnabled="{x:Bind ViewModel.EnableNumbering, Mode=OneWay}"
										SelectedIndex="{x:Bind ViewModel.NumberingPosition, Mode=TwoWay}">
										<ComboBoxItem Content="Sufixo (Final do nome)" />
										<ComboBoxItem Content="Prefixo (Início do nome)" />
										<ComboBoxItem Content="Substituir nome completamente" />
									</ComboBox>
									<Grid ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<NumberBox
											Header="Início"
											IsEnabled="{x:Bind ViewModel.EnableNumbering, Mode=OneWay}"
											Value="{x:Bind ViewModel.NumberingStart, Mode=TwoWay}"
											SpinButtonPlacementMode="Inline"
											SmallChange="1" />
										<NumberBox
											Grid.Column="1"
											Header="Dígitos (zeros)"
											IsEnabled="{x:Bind ViewModel.EnableNumbering, Mode=OneWay}"
											Value="{x:Bind ViewModel.NumberingPadding, Mode=TwoWay}"
											SpinButtonPlacementMode="Inline"
											Minimum="1"
											Maximum="6"
											SmallChange="1" />
									</Grid>
									<TextBox
										Header="Separador"
										IsEnabled="{x:Bind ViewModel.EnableNumbering, Mode=OneWay}"
										Text="{x:Bind ViewModel.NumberingSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
							</Expander>

							<!--  Caixa  -->
							<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
								<Expander.Header>
									<TextBlock FontWeight="SemiBold" Text="Maiúsculas / Minúsculas" />
								</Expander.Header>
								<ComboBox
									HorizontalAlignment="Stretch"
									SelectedIndex="{x:Bind ViewModel.SelectedCaseTransform, Mode=TwoWay}">
									<ComboBoxItem Content="Manter original" />
									<ComboBoxItem Content="TUDO MAIÚSCULO" />
									<ComboBoxItem Content="tudo minúsculo" />
									<ComboBoxItem Content="Primeira Letra De Cada Palavra" />
									<ComboBoxItem Content="Primeira letra da frase" />
								</ComboBox>
							</Expander>

							<!--  Espaços  -->
							<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
								<Expander.Header>
									<Grid ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock FontWeight="SemiBold" Text="Substituir Espaços" VerticalAlignment="Center" />
										<ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableReplaceSpaces, Mode=TwoWay}" OnContent="" OffContent="" />
									</Grid>
								</Expander.Header>
								<TextBox
									IsEnabled="{x:Bind ViewModel.EnableReplaceSpaces, Mode=OneWay}"
									Header="Trocar espaços por"
									Text="{x:Bind ViewModel.SpaceReplacementChar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Expander>

							<!--  Data  -->
							<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
								<Expander.Header>
									<Grid ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock FontWeight="SemiBold" Text="Inserir Data" VerticalAlignment="Center" />
										<ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableDate, Mode=TwoWay}" OnContent="" OffContent="" />
									</Grid>
								</Expander.Header>
								<StackPanel Spacing="8">
									<ComboBox
										HorizontalAlignment="Stretch"
										Header="Posição da Data"
										IsEnabled="{x:Bind ViewModel.EnableDate, Mode=OneWay}"
										SelectedIndex="{x:Bind ViewModel.DatePosition, Mode=TwoWay}">
										<ComboBoxItem Content="Prefixo (Início do nome)" />
										<ComboBoxItem Content="Sufixo (Final do nome)" />
									</ComboBox>
									<TextBox
										Header="Formato da Data"
										IsEnabled="{x:Bind ViewModel.EnableDate, Mode=OneWay}"
										Text="{x:Bind ViewModel.DateFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
							</Expander>

						</StackPanel>
					</ScrollViewer>
				</TabViewItem>

				<!--  Aba 2: Edição como Texto (US4)  -->
				<TabViewItem Header="Edição como Texto" IsClosable="False">
					<Grid Padding="0,8,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock
							Margin="0,0,0,8"
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Edite os nomes diretamente (um por linha). A quantidade de linhas deve corresponder à seleção."
							TextWrapping="Wrap" />
						<TextBox
							Grid.Row="1"
							AcceptsReturn="True"
							FontFamily="Consolas, Cascadia Code, monospace"
							FontSize="12"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							Text="{x:Bind ViewModel.TextModeContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					</Grid>
				</TabViewItem>
			</TabView.TabItems>
		</TabView>

		<!--  Separador Visual  -->
		<Border
			Grid.Column="1"
			Width="1"
			HorizontalAlignment="Center"
			Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

		<!--  Painel Direito: Pré-visualização ao Vivo  -->
		<Grid Grid.Column="2" RowSpacing="8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!--  Cabeçalho da Prévia  -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					FontWeight="SemiBold"
					VerticalAlignment="Center"
					Text="Pré-visualização dos Nomes" />
				<TextBlock
					Grid.Column="1"
					FontSize="12"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					VerticalAlignment="Center">
					<Run Text="{x:Bind ViewModel.ChangedCount, Mode=OneWay}" />
					<Run Text="alterados de" />
					<Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
					<Run Text="itens" />
				</TextBlock>
			</Grid>

			<!--  Aviso de Conflito (InfoBar)  -->
			<InfoBar
				Grid.Row="1"
				IsOpen="{x:Bind ViewModel.HasConflicts, Mode=OneWay}"
				Message="{x:Bind ViewModel.ConflictMessage, Mode=OneWay}"
				Severity="Error" />

			<!--  Lista de Itens  -->
			<Border
				Grid.Row="2"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<ListView
					ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}"
					SelectionMode="None">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="helpers:RenamePreviewItem">
							<Grid Margin="0,4" ColumnSpacing="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<!--  Nome Original  -->
								<TextBlock
									Text="{x:Bind OriginalFullName}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									TextTrimming="CharacterEllipsis"
									VerticalAlignment="Center" />

								<!--  Seta  -->
								<FontIcon
									Grid.Column="1"
									FontSize="10"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}"
									Glyph="&#xE72A;"
									VerticalAlignment="Center" />

								<!--  Novo Nome  -->
								<TextBlock
									Grid.Column="2"
									Text="{x:Bind NewFullName}"
									FontWeight="SemiBold"
									TextTrimming="CharacterEllipsis"
									VerticalAlignment="Center" />

								<!--  Ícone de Alerta se houver conflito  -->
								<FontIcon
									Grid.Column="3"
									Visibility="{x:Bind HasConflict, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
									Foreground="{ThemeResource SystemFillColorCriticalBrush}"
									Glyph="&#xE783;"
									FontSize="14"
									ToolTipService.ToolTip="{x:Bind ConflictReason}"
									VerticalAlignment="Center" />
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>
		</Grid>
	</Grid>
</ContentDialog>
