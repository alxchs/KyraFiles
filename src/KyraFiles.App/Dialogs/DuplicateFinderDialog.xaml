<ContentDialog
	x:Class="KyraFiles.App.Dialogs.DuplicateFinderDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:KyraFiles.App.ViewModels.Dialogs"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=DuplicateFinderDialogTitle}"
	Width="820"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
	PrimaryButtonText="{helpers:ResourceString Name=DuplicateFinderMoveToTrash}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<ResourceDictionary>
			<converters:BoolNegationConverter x:Key="BoolNegationConverter" />
			<converters:BoolToVisibilityConverter
				x:Key="NegatedBoolToVisibilityConverter"
				FalseValue="Visible"
				TrueValue="Collapsed" />
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</ContentDialog.Resources>

	<Grid Height="480" RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Linha 0: Pastas alvo, Modo de Comparação e Opções -->
		<Grid Grid.Row="0" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
				<TextBlock
					Text="Pastas analisadas:"
					FontSize="11"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<TextBlock
					Text="{x:Bind ViewModel.TargetFoldersText, Mode=OneWay}"
					FontWeight="SemiBold"
					FontSize="12"
					TextTrimming="CharacterEllipsis" />
			</StackPanel>

			<ComboBox
				Grid.Column="1"
				SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}"
				IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
				VerticalAlignment="Center">
				<ComboBoxItem Content="{helpers:ResourceString Name=DuplicateFinderModeExact}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=DuplicateFinderModeQuick}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=DuplicateFinderModeNameSize}" />
			</ComboBox>

			<CheckBox
				Grid.Column="2"
				Content="{helpers:ResourceString Name=DuplicateFinderIgnoreDevFolders}"
				IsChecked="{x:Bind ViewModel.IgnoreDevFolders, Mode=TwoWay}"
				IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
				VerticalAlignment="Center" />
		</Grid>

		<!-- Linha 1: Barra de Ações (Regras de Seleção e Reanálise) -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button
					Command="{x:Bind ViewModel.KeepOldestAllCommand}"
					Content="{helpers:ResourceString Name=DuplicateFinderKeepOldest}"
					IsEnabled="{x:Bind ViewModel.HasGroups, Mode=OneWay}"
					Padding="8,4" />
				<Button
					Command="{x:Bind ViewModel.KeepNewestAllCommand}"
					Content="{helpers:ResourceString Name=DuplicateFinderKeepNewest}"
					IsEnabled="{x:Bind ViewModel.HasGroups, Mode=OneWay}"
					Padding="8,4" />
				<Button
					Command="{x:Bind ViewModel.ClearAllSelectionsCommand}"
					Content="{helpers:ResourceString Name=DuplicateFinderDeselectAll}"
					IsEnabled="{x:Bind ViewModel.HasGroups, Mode=OneWay}"
					Padding="8,4" />
			</StackPanel>

			<Button
				Grid.Column="1"
				Command="{x:Bind ViewModel.StartScanCommand}"
				IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
				Content="Reanalisar"
				Padding="12,4" />
		</Grid>

		<!-- Linha 2: Área Central (Progresso, Vazio ou Lista de Grupos) -->
		<Grid Grid.Row="2">
			<!-- Indicador de Varredura / Progresso -->
			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="12"
				Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
				<ProgressRing IsActive="True" Width="40" Height="40" />
				<TextBlock
					Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<Button
					Command="{x:Bind ViewModel.CancelScanCommand}"
					Content="Cancelar Análise"
					HorizontalAlignment="Center"
					Margin="0,4,0,0" />
			</StackPanel>

			<!-- Estado vazio (sem duplicados encontrados) -->
			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="8"
				Visibility="{x:Bind ViewModel.HasGroups, Converter={StaticResource NegatedBoolToVisibilityConverter}, Mode=OneWay}">
				<FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
				<TextBlock
					Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>

			<!-- Lista de Grupos Duplicados -->
			<Border
				BorderThickness="1"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				CornerRadius="4"
				Visibility="{x:Bind ViewModel.HasGroups, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
				<ListView
					ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
					SelectionMode="None">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="dialogs:DuplicateGroupViewModel">
							<Border
								Margin="0,4,0,8"
								Padding="10,8"
								Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="6">
								<StackPanel Spacing="6">
									<!-- Cabeçalho do Grupo -->
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Text="{x:Bind GroupHeader}"
											FontWeight="SemiBold"
											FontSize="13"
											TextTrimming="CharacterEllipsis" />
										<TextBlock
											Grid.Column="1"
											Text="{x:Bind FormattedReclaimable, Mode=OneWay}"
											Foreground="{ThemeResource AccentFillColorDefaultBrush}"
											FontWeight="SemiBold"
											FontSize="12" />
									</Grid>

									<!-- Lista de Cópias do Grupo -->
									<ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="dialogs:DuplicateFileItemViewModel">
												<Grid
													Padding="4,3"
													ColumnSpacing="8"
													Background="Transparent">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="140" />
														<ColumnDefinition Width="90" />
														<ColumnDefinition Width="110" />
													</Grid.ColumnDefinitions>

													<!-- Checkbox de Seleção (com invariante de nunca permitir marcar a última cópia) -->
													<CheckBox
														Grid.Column="0"
														IsChecked="{x:Bind IsSelectedForDeletion, Mode=TwoWay}"
														IsEnabled="{x:Bind CanToggleSelection, Mode=OneWay}"
														VerticalAlignment="Center" />

													<!-- Caminho Completo da Cópia -->
													<StackPanel Grid.Column="1" VerticalAlignment="Center">
														<TextBlock
															Text="{x:Bind FilePath}"
															FontSize="11"
															TextTrimming="CharacterEllipsis" />
													</StackPanel>

													<!-- Data de Modificação -->
													<TextBlock
														Grid.Column="2"
														Text="{x:Bind ModifiedAtFormatted}"
														FontSize="11"
														Foreground="{ThemeResource TextFillColorSecondaryBrush}"
														VerticalAlignment="Center" />

													<!-- Tamanho -->
													<TextBlock
														Grid.Column="3"
														Text="{x:Bind FormattedSize}"
														FontSize="11"
														HorizontalAlignment="Right"
														VerticalAlignment="Center" />

													<!-- Status (ex: Excluído para a lixeira) -->
													<TextBlock
														Grid.Column="4"
														Text="{x:Bind Status, Mode=OneWay}"
														FontSize="11"
														Foreground="{ThemeResource AccentFillColorDefaultBrush}"
														HorizontalAlignment="Right"
														VerticalAlignment="Center" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>
		</Grid>

		<!-- Linha 3: Resumo e Status Inferior -->
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
				FontWeight="SemiBold"
				FontSize="12"
				VerticalAlignment="Center" />

			<TextBlock
				Grid.Column="1"
				Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				FontSize="11"
				VerticalAlignment="Center" />
		</Grid>
	</Grid>
</ContentDialog>
