<ContentDialog
	x:Class="KyraFiles.App.Dialogs.ChooseDetailsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:KyraFiles.App.ViewModels.Dialogs"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=ChooseDetailsDialogTitle}"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	PrimaryButtonText="{helpers:ResourceString Name=OK}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<Grid Width="500" Height="420" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Search Filter  -->
		<TextBox
			Grid.Row="0"
			PlaceholderText="{helpers:ResourceString Name=ChooseDetailsDialogSearchPlaceholder}"
			Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<!--  Columns List  -->
		<Border
			Grid.Row="1"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="4">
			<ListView
				ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
				SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="dialogs:ChooseDetailsItemViewModel">
						<Grid Padding="4,2" ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<CheckBox
								Grid.Column="0"
								MinWidth="0"
								IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />

							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								Text="{x:Bind DisplayName, Mode=OneWay}" />

							<TextBlock
								Grid.Column="2"
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								FontSize="12"
								Text="{x:Bind Category, Mode=OneWay}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Border>
	</Grid>
</ContentDialog>
