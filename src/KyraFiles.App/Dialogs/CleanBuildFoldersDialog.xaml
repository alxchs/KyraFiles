<ContentDialog
	x:Class="KyraFiles.App.Dialogs.CleanBuildFoldersDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:KyraFiles.App.ViewModels.Dialogs"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=CleanBuildFoldersDialogTitle}"
	Width="780"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<ResourceDictionary>
			<converters:BoolNegationConverter x:Key="BoolNegationConverter" />
			<converters:BoolToVisibilityConverter
				x:Key="NegatedBoolToVisibilityConverter"
				FalseValue="Visible"
				TrueValue="Collapsed" />
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</ContentDialog.Resources>

	<Grid Height="440" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Linha 0: Caminho base e status -->
		<StackPanel Grid.Row="0" Spacing="4">
			<TextBlock
				Text="{x:Bind ViewModel.RootPath, Mode=OneWay}"
				TextTrimming="CharacterEllipsis"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				FontSize="12" />
		</StackPanel>

		<!-- Linha 1: Barra de Ações (Selecionar tudo, desmarcar, opção de exclusão definitiva) -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button
					Command="{x:Bind ViewModel.SelectAllCommand}"
					Content="{helpers:ResourceString Name=CleanBuildFoldersSelectAll}"
					Padding="8,4" />
				<Button
					Command="{x:Bind ViewModel.DeselectAllCommand}"
					Content="{helpers:ResourceString Name=CleanBuildFoldersDeselectAll}"
					Padding="8,4" />
			</StackPanel>

			<CheckBox
				Grid.Column="1"
				Content="{helpers:ResourceString Name=CleanBuildFoldersDeletePermanently}"
				IsChecked="{x:Bind ViewModel.DeletePermanently, Mode=TwoWay}"
				IsEnabled="{x:Bind ViewModel.IsDeleting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
		</Grid>

		<!-- Linha 2: Lista de Pastas Encontradas -->
		<Grid Grid.Row="2">
			<!-- Indicador de Carregamento / Varredura -->
			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="12"
				Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
				<ProgressRing IsActive="True" Width="36" Height="36" />
				<TextBlock
					Text="Localizando pastas de compilação..."
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>

			<!-- Mensagem quando nenhuma pasta é encontrada -->
			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="8"
				Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource NegatedBoolToVisibilityConverter}, Mode=OneWay}">
				<FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
				<TextBlock
					Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>

			<!-- Lista de Itens -->
			<Border
				BorderThickness="1"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				CornerRadius="4"
				Visibility="{x:Bind ViewModel.HasItems, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
				<ListView
					ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
					SelectionMode="None">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="dialogs:BuildFolderItemViewModel">
							<Grid Height="48" ColumnSpacing="12" Padding="8,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="130" />
									<ColumnDefinition Width="90" />
									<ColumnDefinition Width="100" />
								</Grid.ColumnDefinitions>

								<!-- CheckBox de Seleção -->
								<CheckBox
									Grid.Column="0"
									IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
									IsEnabled="{x:Bind CanToggleSelection, Mode=OneWay}"
									VerticalAlignment="Center" />

								<!-- Nome da Pasta e Caminho Completo -->
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock
										Text="{x:Bind FolderName}"
										FontWeight="SemiBold"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Text="{x:Bind FolderPath}"
										FontSize="11"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>

								<!-- Projeto e Tipo -->
								<StackPanel Grid.Column="2" VerticalAlignment="Center">
									<TextBlock
										Text="{x:Bind ProjectName}"
										FontSize="12"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Text="{x:Bind ProjectType}"
										FontSize="11"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</StackPanel>

								<!-- Tamanho -->
								<TextBlock
									Grid.Column="3"
									Text="{x:Bind FormattedSize, Mode=OneWay}"
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									FontWeight="SemiBold" />

								<!-- Status (Em uso / Excluído) -->
								<TextBlock
									Grid.Column="4"
									Text="{x:Bind Status, Mode=OneWay}"
									VerticalAlignment="Center"
									HorizontalAlignment="Right"
									FontSize="11"
									Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>
		</Grid>

		<!-- Linha 3: Resumo e Barra de Status -->
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<ProgressRing
					IsActive="True"
					Width="16"
					Height="16"
					Visibility="{x:Bind ViewModel.IsCalculatingSize, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
				<TextBlock
					Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
					FontWeight="SemiBold"
					VerticalAlignment="Center" />
			</StackPanel>

			<TextBlock
				Grid.Column="1"
				Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				VerticalAlignment="Center" />
		</Grid>
	</Grid>
</ContentDialog>
