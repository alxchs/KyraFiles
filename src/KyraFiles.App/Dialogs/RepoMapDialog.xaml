<ContentDialog
	x:Class="KyraFiles.App.Dialogs.RepoMapDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:KyraFiles.App.ViewModels.Dialogs"
	xmlns:helpers="using:KyraFiles.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=RepoMapDialogTitle}"
	Width="900"
	DefaultButton="None"
	HighContrastAdjustment="None"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	PrimaryButtonText="{helpers:ResourceString Name=RepoMapExportMarkdown}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
	SecondaryButtonText="{helpers:ResourceString Name=RepoMapExportCsv}"
	CloseButtonText="{helpers:ResourceString Name=Close}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<ResourceDictionary>
			<converters:BoolNegationConverter x:Key="BoolNegationConverter" />
			<converters:BoolToVisibilityConverter
				x:Key="NegatedBoolToVisibilityConverter"
				FalseValue="Visible"
				TrueValue="Collapsed" />
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</ContentDialog.Resources>

	<Grid Height="540" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Linha 0: Pasta analisada -->
		<StackPanel Grid.Row="0" Spacing="2">
			<TextBlock
				FontSize="11"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="Repositório / Pasta analisada:" />
			<TextBlock
				FontSize="12"
				FontWeight="SemiBold"
				Text="{x:Bind ViewModel.TargetFolder, Mode=OneWay}"
				TextTrimming="CharacterEllipsis" />
		</StackPanel>

		<!-- Linha 1: Opções + Botões Analisar / Cancelar -->
		<Grid Grid.Row="1" ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel
				Grid.Column="0"
				Orientation="Horizontal"
				Spacing="16"
				VerticalAlignment="Center">
				<CheckBox
					Content="{helpers:ResourceString Name=RepoMapRespectGitIgnore}"
					IsChecked="{x:Bind ViewModel.RespectGitIgnore, Mode=TwoWay}"
					IsEnabled="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
				<CheckBox
					Content="{helpers:ResourceString Name=RepoMapIncludeHotSpots}"
					IsChecked="{x:Bind ViewModel.IncludeGitHotSpots, Mode=TwoWay}"
					IsEnabled="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
			</StackPanel>

			<Button
				Grid.Column="1"
				Command="{x:Bind ViewModel.AnalyzeCommand}"
				IsEnabled="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<FontIcon FontSize="14" Glyph="&#xE72C;" />
					<TextBlock Text="{helpers:ResourceString Name=RepoMapAnalyze}" />
				</StackPanel>
			</Button>

			<Button
				Grid.Column="2"
				Command="{x:Bind ViewModel.CancelCommand}"
				IsEnabled="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<FontIcon FontSize="14" Glyph="&#xE711;" />
					<TextBlock Text="{helpers:ResourceString Name=Cancel}" />
				</StackPanel>
			</Button>
		</Grid>

		<!-- Linha 2: Barra de Progresso + Resumo Geral -->
		<StackPanel Grid.Row="2" Spacing="4">
			<ProgressBar
				IsIndeterminate="True"
				Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
			<Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Column="0"
					FontSize="12"
					FontWeight="SemiBold"
					Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
					Text="{x:Bind ViewModel.TotalSummaryText, Mode=OneWay}" />
				<TextBlock
					Grid.Column="1"
					FontSize="11"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
			</Grid>
		</StackPanel>

		<!-- Linha 3: Conteúdo em Tabs -->
		<TabView Grid.Row="3" CanReorderTabs="False" IsAddTabButtonVisible="False">
			<TabView.TabItems>
				<!-- Aba 1: Linguagens (Resumo + Arquivos por Linguagem) -->
				<TabViewItem Header="{helpers:ResourceString Name=RepoMapLanguagesTab}" IsClosable="False">
					<Grid ColumnSpacing="12" Margin="0,8,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="360" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- Coluna Esquerda: Lista de Linguagens -->
						<ListView
							Grid.Column="0"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="4"
							ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
							SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
							SelectionMode="Single">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="dialogs:LanguageInfoViewModel">
									<Grid Padding="4,6" ColumnSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<TextBlock
											Grid.Row="0"
											Grid.Column="0"
											FontWeight="SemiBold"
											Text="{x:Bind LanguageName}" />
										<TextBlock
											Grid.Row="0"
											Grid.Column="1"
											FontSize="11"
											FontWeight="SemiBold"
											Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
											Text="{x:Bind FormattedTotalBytes}" />
										<TextBlock
											Grid.Row="1"
											Grid.Column="0"
											Grid.ColumnSpan="2"
											FontSize="11"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Text="{x:Bind FormattedSummary}" />
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>

						<!-- Coluna Direita: Arquivos da Linguagem Selecionada (maior para o menor) -->
						<Grid Grid.Column="1" RowSpacing="6">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="Arquivos da linguagem selecionada (do maior para o menor):" />

							<ListView
								Grid.Row="1"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="4"
								DoubleTapped="FilesListView_DoubleTapped"
								ItemsSource="{x:Bind ViewModel.SelectedLanguageFiles, Mode=OneWay}"
								SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
								SelectionMode="Single">
								<ListView.ItemTemplate>
									<DataTemplate x:DataType="dialogs:RepoFileInfoViewModel">
										<Grid Padding="4,4" ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												FontFamily="Cascadia Mono, Consolas, Courier New"
												FontSize="12"
												Text="{x:Bind RelativePath}"
												TextTrimming="CharacterEllipsis" />
											<TextBlock
												Grid.Column="1"
												FontSize="11"
												Foreground="{ThemeResource TextFillColorSecondaryBrush}"
												Text="{x:Bind FormattedLineCount}" />
											<TextBlock
												Grid.Column="2"
												FontSize="11"
												FontWeight="SemiBold"
												Foreground="{ThemeResource TextFillColorPrimaryBrush}"
												Text="{x:Bind FormattedSize}" />
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Grid>
					</Grid>
				</TabViewItem>

				<!-- Aba 2: Maiores Arquivos do Repositório -->
				<TabViewItem Header="{helpers:ResourceString Name=RepoMapLargestFilesTab}" IsClosable="False">
					<ListView
						Margin="0,8,0,0"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="4"
						DoubleTapped="FilesListView_DoubleTapped"
						ItemsSource="{x:Bind ViewModel.LargestFiles, Mode=OneWay}"
						SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
						SelectionMode="Single">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="dialogs:RepoFileInfoViewModel">
								<Grid Padding="6,6" ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="120" />
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="90" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										FontFamily="Cascadia Mono, Consolas, Courier New"
										FontSize="12"
										Text="{x:Bind RelativePath}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="1"
										FontSize="11"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Text="{x:Bind Language}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="2"
										FontSize="11"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Text="{x:Bind FormattedLineCount}" />
									<TextBlock
										Grid.Column="3"
										FontSize="11"
										FontWeight="SemiBold"
										Foreground="{ThemeResource TextFillColorPrimaryBrush}"
										Text="{x:Bind FormattedSize}" />
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</TabViewItem>

				<!-- Aba 3: Pontos Quentes Git (Mudanças × Tamanho) -->
				<TabViewItem Header="{helpers:ResourceString Name=RepoMapHotSpotsTab}" IsClosable="False">
					<Grid Margin="0,8,0,0">
						<!-- Quando não for repositório Git -->
						<InfoBar
							Title="Git não detectado"
							IsOpen="True"
							IsClosable="False"
							Message="{x:Bind ViewModel.GitStatusMessage, Mode=OneWay}"
							Severity="Informational"
							VerticalAlignment="Top"
							Visibility="{x:Bind ViewModel.IsGitRepository, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibilityConverter}}" />

						<!-- Quando for repositório Git -->
						<ListView
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="4"
							DoubleTapped="FilesListView_DoubleTapped"
							ItemsSource="{x:Bind ViewModel.HotSpots, Mode=OneWay}"
							SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
							SelectionMode="Single"
							Visibility="{x:Bind ViewModel.IsGitRepository, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="dialogs:RepoFileInfoViewModel">
									<Grid Padding="6,6" ColumnSpacing="12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="140" />
											<ColumnDefinition Width="90" />
											<ColumnDefinition Width="90" />
											<ColumnDefinition Width="100" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											FontFamily="Cascadia Mono, Consolas, Courier New"
											FontSize="12"
											Text="{x:Bind RelativePath}"
											TextTrimming="CharacterEllipsis" />
										<TextBlock
											Grid.Column="1"
											FontSize="11"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Text="{x:Bind FormattedCommitCount}" />
										<TextBlock
											Grid.Column="2"
											FontSize="11"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Text="{x:Bind FormattedLineCount}" />
										<TextBlock
											Grid.Column="3"
											FontSize="11"
											Foreground="{ThemeResource TextFillColorPrimaryBrush}"
											Text="{x:Bind FormattedSize}" />
										<TextBlock
											Grid.Column="4"
											FontSize="11"
											FontWeight="SemiBold"
											Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
											Text="{x:Bind FormattedHotSpotScore}" />
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Grid>
				</TabViewItem>
			</TabView.TabItems>
		</TabView>

		<!-- Linha 4: Mensagem de status -->
		<TextBlock
			Grid.Row="4"
			FontSize="11"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
			TextTrimming="CharacterEllipsis" />
	</Grid>
</ContentDialog>
