<Page
	x:Class="Files.App.Views.HexEditor.HexEditorPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.HexEditor"
	Background="{ThemeResource App.Theme.BackgroundBrush}"
	HighContrastAdjustment="None"
	KeyDown="Page_KeyDown"
	Loaded="Page_Loaded"
	mc:Ignorable="d">

	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<!-- Toolbar / Header -->
		<Grid
			Grid.Row="0"
			Margin="12,8,12,8"
			ColumnDefinitions="Auto,*,Auto">
			<StackPanel
				Grid.Column="0"
				Orientation="Horizontal"
				Spacing="6">
				<!-- Save Button -->
				<Button
					x:Name="SaveButton"
					Click="SaveButton_Click"
					IsEnabled="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}"
					ToolTipService.ToolTip="Save (Ctrl+S)">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="14" Glyph="&#xE74E;" />
						<TextBlock Text="{helpers:ResourceString Name=Save}" />
					</StackPanel>
				</Button>
				<!-- Undo Button -->
				<Button
					x:Name="UndoButton"
					Click="UndoButton_Click"
					IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
					ToolTipService.ToolTip="Undo (Ctrl+Z)">
					<FontIcon FontSize="14" Glyph="&#xE7A7;" />
				</Button>
				<!-- Redo Button -->
				<Button
					x:Name="RedoButton"
					Click="RedoButton_Click"
					IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
					ToolTipService.ToolTip="Redo (Ctrl+Y)">
					<FontIcon FontSize="14" Glyph="&#xE7A6;" />
				</Button>
				<!-- Go to Offset Button -->
				<Button
					x:Name="GoToOffsetButton"
					Click="GoToOffsetButton_Click"
					ToolTipService.ToolTip="Go to offset (Ctrl+G)">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="14" Glyph="&#xE721;" />
						<TextBlock Text="{helpers:ResourceString Name=HexEditorGoToOffset}" />
					</StackPanel>
				</Button>
			</StackPanel>

			<TextBlock
				Grid.Column="1"
				Margin="16,0,0,0"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
				TextTrimming="CharacterEllipsis" />

			<!-- Save Status / InfoBar inline -->
			<TextBlock
				Grid.Column="2"
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				Foreground="{ThemeResource SystemFillColorCautionBrush}"
				Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
		</Grid>

		<!-- Column Headers -->
		<Border
			Grid.Row="1"
			Padding="12,4,12,4"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,1">
			<Grid ColumnDefinitions="110,480,200,*">
				<TextBlock
					Grid.Column="0"
					FontFamily="Consolas, Cascadia Mono, Courier New"
					FontSize="12"
					FontWeight="SemiBold"
					Text="Offset (h)" />
				<TextBlock
					Grid.Column="1"
					FontFamily="Consolas, Cascadia Mono, Courier New"
					FontSize="12"
					FontWeight="SemiBold"
					Text="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F" />
				<TextBlock
					Grid.Column="2"
					FontFamily="Consolas, Cascadia Mono, Courier New"
					FontSize="12"
					FontWeight="SemiBold"
					Text="Decoded text" />
			</Grid>
		</Border>

		<!-- Virtualized Grid Rows Area -->
		<Grid
			Grid.Row="2"
			ColumnDefinitions="*,Auto"
			PointerWheelChanged="Grid_PointerWheelChanged">
			<!-- Rows ItemsControl -->
			<ItemsControl
				Grid.Column="0"
				Margin="12,4,0,4"
				ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:HexRowViewModel">
						<Grid Height="22" ColumnDefinitions="110,480,200,*">
							<!-- Offset -->
							<TextBlock
								Grid.Column="0"
								VerticalAlignment="Center"
								FontFamily="Consolas, Cascadia Mono, Courier New"
								FontSize="13"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind OffsetHex}" />

							<!-- 16 Hex Cells -->
							<ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:HexByteCellViewModel">
										<Border
											Width="25"
											Height="20"
											Margin="0,0,3,0"
											Background="{x:Bind BackgroundBrush, Mode=OneWay}"
											CornerRadius="2"
											PointerPressed="Cell_PointerPressed">
											<TextBlock
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontFamily="Consolas, Cascadia Mono, Courier New"
												FontSize="13"
												Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
												Text="{x:Bind HexText, Mode=OneWay}" />
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Decoded Text (16 characters) -->
							<ItemsControl Grid.Column="2" ItemsSource="{x:Bind Cells}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:HexByteCellViewModel">
										<Border
											Width="12"
											Height="20"
											Background="{x:Bind TextBackgroundBrush, Mode=OneWay}"
											CornerRadius="2"
											PointerPressed="Cell_PointerPressed">
											<TextBlock
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontFamily="Consolas, Cascadia Mono, Courier New"
												FontSize="13"
												Foreground="{x:Bind TextForegroundBrush, Mode=OneWay}"
												Text="{x:Bind AsciiChar, Mode=OneWay}" />
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Vertical ScrollBar -->
			<ScrollBar
				x:Name="RowScrollBar"
				Grid.Column="1"
				LargeChange="30"
				Minimum="0"
				Orientation="Vertical"
				SmallChange="1"
				ValueChanged="ScrollBar_ValueChanged" />
		</Grid>

		<!-- Status Bar -->
		<Border
			Grid.Row="3"
			Padding="12,6,12,6"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="Auto,Auto,Auto,*">
				<TextBlock
					Grid.Column="0"
					Margin="0,0,24,0"
					FontSize="12"
					Text="{x:Bind ViewModel.OffsetStatusText, Mode=OneWay}" />
				<TextBlock
					Grid.Column="1"
					Margin="0,0,24,0"
					FontSize="12"
					Text="{x:Bind ViewModel.SizeStatusText, Mode=OneWay}" />
				<TextBlock
					Grid.Column="2"
					Margin="0,0,24,0"
					FontSize="12"
					Text="{x:Bind ViewModel.ModifiedStatusText, Mode=OneWay}" />
			</Grid>
		</Border>
	</Grid>
</Page>
