<ContentDialog
	x:Class="KyraFiles.App.Dialogs.OperationHistoryDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:KyraFiles.App.ViewModels.Dialogs"
	Title="Historico de operacoes"
	CloseButtonText="Fechar"
	DefaultButton="Close"
	Style="{StaticResource DefaultContentDialogStyle}">

	<Grid
		Width="680"
		Height="460"
		RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="170" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
				Grid.Column="0"
				PlaceholderText="Filtrar por nome ou caminho..."
				Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<ComboBox
				Grid.Column="1"
				HorizontalAlignment="Stretch"
				SelectedIndex="{x:Bind ViewModel.SelectedKindFilterIndex, Mode=TwoWay}">
				<ComboBoxItem Content="Todos os tipos" />
				<ComboBoxItem Content="Copiar" />
				<ComboBoxItem Content="Mover" />
				<ComboBoxItem Content="Renomear" />
				<ComboBoxItem Content="Lixeira" />
				<ComboBoxItem Content="Excluir definitivo" />
				<ComboBoxItem Content="Criar" />
			</ComboBox>

			<Button
				Grid.Column="2"
				Click="ClearButton_Click"
				Content="Limpar" />
		</Grid>

		<InfoBar
			Grid.Row="1"
			IsClosable="True"
			IsOpen="{x:Bind ViewModel.HasStatusBanner, Mode=TwoWay}"
			Message="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
			Severity="Informational" />

		<ListView
			Grid.Row="2"
			ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
			SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="vm:OperationHistoryRowViewModel">
					<Grid Padding="4,6" ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="115" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="0"
							VerticalAlignment="Center"
							Opacity="0.7"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="{x:Bind TimestampText}" />

						<TextBlock
							Grid.Column="1"
							VerticalAlignment="Center"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind KindLabel}" />

						<StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
							<TextBlock
								Style="{StaticResource BodyTextBlockStyle}"
								Text="{x:Bind SummaryText}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								Opacity="0.65"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind DetailPathText}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>

						<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<TextBlock
								VerticalAlignment="Center"
								Opacity="0.7"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind StatusText}" />
							<Button
								Click="UndoRowButton_Click"
								Content="Desfazer"
								Tag="{x:Bind}"
								Visibility="{x:Bind ShowUndoButton}" />
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
			<ToggleSwitch
				IsOn="{x:Bind ViewModel.PersistenceEnabled, Mode=TwoWay}"
				OffContent="Persistir em disco: Desligado"
				OnContent="Persistir em disco: Ligado" />
		</StackPanel>
	</Grid>
</ContentDialog>
