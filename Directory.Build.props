<Project>
  <PropertyGroup>

    <!--  Generic properties  -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
    <TargetWindowsVersion>10.0.26100.0</TargetWindowsVersion>
    <MinimalWindowsVersion>10.0.19041.0</MinimalWindowsVersion>
    <WindowsSdkPackageVersion>10.0.26100.67-preview</WindowsSdkPackageVersion>
    <WindowsTargetFramework>$(TargetFrameworkVersion)-windows$(TargetWindowsVersion)</WindowsTargetFramework>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <!--  Use Microsoft.Testing.Platform  -->
    <EnableMSTestRunner>true</EnableMSTestRunner>

    <!--  Use strict Roslyn compilation mode  -->
    <Features>strict</Features>

    <!--  Enable all C#/WinRT trimming and NativeAOT diagnostics  -->
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>

    <!-- Restrict Git configuration scope to local repository to avoid sandbox permission errors with global includeIf -->
    <GitRepositoryConfigurationScope>local</GitRepositoryConfigurationScope>

    <!-- Avoid multi-node parallel MSBuild issues in sandbox -->
    <BuildInParallel>false</BuildInParallel>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>

    <!-- Avoid offline vulnerability audit network errors in sandbox -->
    <NuGetAudit>false</NuGetAudit>

  </PropertyGroup>
</Project>
